{
  "name": "decision-router",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cost-aware Decision Router for GitHub Copilot CLI and VS Code",
  "repository": {
    "type": "git",
    "url": "https://github.com/kinfey/decision-ghc-router.git"
  },
  "homepage": "https://github.com/kinfey/decision-ghc-router",
  "bin": {
    "decision-router": "bin/jev-copilot.mjs",
    "jev-copilot": "bin/jev-copilot.mjs"
  },
  "scripts": {
    "start": "node bin/jev-copilot.mjs",
    "models": "node bin/jev-copilot.mjs models",
    "router": "node bin/jev-copilot.mjs router",
    "install:router": "node bin/install-router.mjs",
    "uninstall:router": "node bin/install-router.mjs --uninstall",
    "build:vscode": "node vscode/build.mjs",
    "check:vscode": "tsc --project vscode/tsconfig.json --noEmit",
    "package:vscode": "npm run build:vscode && cd vscode && vsce package --no-dependencies --allow-missing-repository --skip-license --out ../decision-router.vsix",
    "test:live-router": "node test/live-native-router.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "engines": { "node": ">=22.16" },
  "dependencies": {
    "@github/copilot-sdk": "1.0.21",
    "@typesafe-ai/sdk": "0.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.140.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "typescript": "^5.9.3"
  }
}
