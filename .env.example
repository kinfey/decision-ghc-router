# typesafe (default) or azure; both backends only choose the Copilot execution model.
JEV_PROVIDER=typesafe
JEV_API_KEY=
# Azure requires a full systemone URL and the deployed model's name.
AZURE_DECISION_ENDPOINT=
AZURE_DECISION_API_KEY=
AZURE_DECISION_MODEL=Decision-1
# Optional native CLI executable (default: copilot).
COPILOT_CLI_PATH=copilot
# Estimated uncached input and output tokens, not an actual bill or token limit.
JEV_INPUT_TOKENS=10000
JEV_OUTPUT_TOKENS=2000
# Fail closed on JEV errors by default. Opt in to the cheapest priced model:
JEV_FALLBACK_CHEAPEST=0
