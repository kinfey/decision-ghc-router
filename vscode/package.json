{
  "name": "desicion-router",
  "displayName": "Desicion Router",
  "description": "Choose low-cost available GitHub Copilot models through JEV in the native chat model picker.",
  "publisher": "local-jev",
  "version": "0.1.0",
  "private": true,
  "engines": { "vscode": "^1.140.0" },
  "categories": ["AI", "Chat"],
  "main": "./out/extension.cjs",
  "activationEvents": ["onLanguageModelChatProvider:desicion-router"],
  "contributes": {
    "languageModelChatProviders": [{
      "vendor": "desicion-router",
      "displayName": "Desicion Router",
      "managementCommand": "desicionRouter.configure"
    }],
    "commands": [
      { "command": "desicionRouter.configure", "title": "Desicion Router: Configure .env" },
      { "command": "desicionRouter.refresh", "title": "Desicion Router: Refresh Models" }
    ],
    "configuration": {
      "title": "Desicion Router",
      "properties": {
        "desicionRouter.envFile": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Absolute path to your local .env containing TypeSafe or Azure Decision configuration and credentials. Keys are never stored in editor settings."
        }
      }
    }
  }
}
