{
  "name": "decision-router",
  "displayName": "Decision Router",
  "description": "Choose low-cost available GitHub Copilot models through JEV in the native chat model picker.",
  "publisher": "local-jev",
  "repository": {
    "type": "git",
    "url": "https://github.com/kinfey/decision-ghc-router.git"
  },
  "homepage": "https://github.com/kinfey/decision-ghc-router",
  "version": "0.1.0",
  "private": true,
  "engines": { "vscode": "^1.140.0" },
  "categories": ["AI", "Chat"],
  "main": "./out/extension.cjs",
  "activationEvents": ["onLanguageModelChatProvider:decision-router"],
  "contributes": {
    "languageModelChatProviders": [{
      "vendor": "decision-router",
      "displayName": "Decision Router",
      "managementCommand": "decisionRouter.configure"
    }],
    "commands": [
      { "command": "decisionRouter.configure", "title": "Decision Router: Configure .env" },
      { "command": "decisionRouter.refresh", "title": "Decision Router: Refresh Models" }
    ],
    "configuration": {
      "title": "Decision Router",
      "properties": {
        "decisionRouter.envFile": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Absolute path to your local .env containing TypeSafe or Azure Decision configuration and credentials. Keys are never stored in editor settings."
        }
      }
    }
  }
}
